; irq_blitter: IRQ L1 handler (blitter), target of the RAM trampoline 0x20f918, which the main loop
;   installs by writing its operand at 0x20f91a. MEASURED 2026-08-03: turning the driver's courtesy
;   IRQ1 off completely, the game does NOT reach the menu at any clock, so the drawing chain does
;   not start itself and that interrupt is indispensable
irq_blitter:
00001f2a  46fc2700              move #0x2700,SR
00001f2e  2f0a                  move.l A2,-(SP)
00001f30  2f09                  move.l A1,-(SP)
00001f32  227900209430          movea.l (DAT_00209430).l,A1
00001f38  610000ca              bsr.w blit_program
00001f3c  225f                  movea.l (SP)+,A1
00001f3e  245f                  movea.l (SP)+,A2
00001f40  4e73                  rte

; irq1_last_blit: Level 1 handler installed by 0x2516 when the list runs out: it fires the blit
;   prepared at 0x209461 and calls 0x22bc, which enqueues the next one or declares the queue empty
irq1_last_blit:
00001f42  46fc2700              move #0x2700,SR
00001f46  2f0a                  move.l A2,-(SP)
00001f48  45f900209461          lea (DAT_00209461).l,A2
00001f4e  13da0070000c          move.b (A2)+,(DAT_0070000c).l  ; page_and_direct_port
00001f54  33da00700000          move.w (A2)+,(blit_data).l  ; src_u_and_dst_x
00001f5a  33da00700004          move.w (A2)+,(DAT_00700004).l  ; src_v_and_dst_y
00001f60  13da0070000f          move.b (A2)+,(DAT_0070000f).l  ; flags
00001f66  33fc00000070001e      move.w #0x0,(DAT_0070001e).l  ; trigger
00001f6e  13da00700003          move.b (A2)+,(DAT_00700003).l  ; src_u1_and_dst_x1
00001f74  13da00700007          move.b (A2)+,(DAT_00700007).l  ; src_v1_and_dst_y1
00001f7a  13d200700013          move.b (A2),(DAT_00700013).l  ; high_bits_and_small_scale
00001f80  33fcffff0070001e      move.w #-0x1,(DAT_0070001e).l  ; trigger
00001f88  2f09                  move.l A1,-(SP)
00001f8a  61000330              bsr.w enqueue_next
00001f8e  225f                  movea.l (SP)+,A1
00001f90  245f                  movea.l (SP)+,A2
00001f92  4e73                  rte

; irq1_chain: Level 1 handler of the chain: it writes the blitter registers from the parameter block
;   at 0x209439, fires the blit (0xffff to 0x70001e, at 0x1fd2) and calls 0x23f2 to prepare the next
;   entry. MEASURED: on the balloon screen EVERY blit comes out of this 0x1fd2, one per interrupt
irq1_chain:
00001f94  46fc2700              move #0x2700,SR
00001f98  2f0a                  move.l A2,-(SP)
00001f9a  45f900209439          lea (DAT_00209439).l,A2
00001fa0  13da0070000c          move.b (A2)+,(DAT_0070000c).l  ; page_and_direct_port
