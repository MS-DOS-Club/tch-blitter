; sound_start_block: A level 5 entry that starts a sound block: sends the 0xffff marker to the
;   subcpu, puts 49 in the sample counter (0x202e86), ARMS THE LINE COUNTER WITH 100 (0x7a0000) and
;   sets bit 13 of 0x20351c, which writes to the control port, then rte. Nothing in the ROM points
;   to it, and the game never enters it: the vblank's own block start (0x520) arms the counter with
;   1
sound_start_block:
000f23d6  33fcffff00740000      move.w #-0x1,(soundlatch).l  ; soundlatch
000f23de  33fc003100202e86      move.w #0x31,(re_snd_sample_count).l
