; snd_mix_out_r: Dumps the sum of voices 2+4+6 to the right DAC. `move.w d7, 0x740000.l`. The stereo
;   split is FIXED by register: there is no pan field anywhere.
; runs from 0x00201132
snd_mix_out_r:
00000626  33c700740000          move.w D7w,(rdac).l

; snd_isr_tail_jmp: `jmp (X).l` with X patchable in RAM at 0x20113a: it is the command machine's
;   state pointer. Each tail chains itself by writing the next one there before its `rte`.
; runs from 0x00201138
snd_isr_tail_jmp:
0000062c  4ef9ffffffff          jmp LAB_ffffffff.l

; snd_cmd_idle: Idle state of the command machine: every IRQ compares the latch (0x780000) against
;   0xffff and, when it arrives, chains to snd_cmd_apply_v12. It is the APPLY token the main CPU
;   sends.
; runs from 0x0020113e
snd_cmd_idle:
00000632  0c79ffff00780000      cmpi.w #-0x1,(soundlatch_r).l
0000063a  660a                  bne.b LAB_00000646
