000007c6  4840                  swap D0
000007c8  31b9007800000000      move.w (soundlatch_r).l,(0x0,A0,D0w*0x1)
000007d0  5440                  addq.w 0x2,D0w
000007d2  0c400060              cmpi.w #0x60,D0w
000007d6  660a                  bne.b LAB_000007e2
000007d8  23fc0020113e0020113a  move.l #0x20113e,(snd_tail_slot).l
LAB_000007e2:
000007e2  4840                  swap D0
000007e4  4e73                  rte

