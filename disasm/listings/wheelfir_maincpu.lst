; wf_background_fill: Emits the word-14 FILLS of the BACKGROUND plane: the seed is a destination 2
;   px wide reading a source one pixel across, and what it clears is the STRIP it declares in
;   height, from edge to edge of the plane. MEASURED over 60 s emulated: 256 declaring rows 0..255
;   and 213 declaring 230..255. Together with wf_sprite_fill it is the mechanism the game clears its
;   planes with
wf_background_fill:
000e540a  33fcffff0070001e      move.w #-0x1,(DAT_0070001e).l  ; trigger
000e5412  43e90018              lea (0x18,A1),A1
000e5416  301f                  move.w (SP)+,D0w
000e5418  4e75                  rts

