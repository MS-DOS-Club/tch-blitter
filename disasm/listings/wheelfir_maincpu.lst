; wf_pal_upload: Uploads a STRETCH of palette to the BT478: starting index in d0, number of colours
;   in d1, source in a0. Seven call sites; in the attract it runs once, on frame 8. The one that
;   runs on every screen is wf_pal_blast
wf_pal_upload:
000e8f4a  2f0a                  move.l A2,-(SP)
000e8f4c  33c000720000          move.w D0w,(DAT_00720000).l
000e8f52  5341                  subq.w 0x1,D1w
