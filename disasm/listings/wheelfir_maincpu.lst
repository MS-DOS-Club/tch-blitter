; wf_stream_scroll_line: Injects each line's control byte (page bit, x and y bit 8) from the scroll
;   table (+0x200) into word 8, once per line over the visible part; the next instructions write the
;   line's x and y bytes. MEASURED with a per-site write log over an attract cycle: 484870 writes at
;   vpos 1..255, the page bit set in 227290
wf_stream_scroll_line:
000dc756  13ee020000700011      move.b (0x200,A6),(DAT_00700011).l  ; scale_and_scroll

; wf_raster_walk: Raster handler: walks the table, writes x and then y
wf_raster_walk:
000dc75e  13de00700015          move.b (A6)+,(DAT_00700015).l  ; scale_x_and_scroll_x
000dc764  13de00700017          move.b (A6)+,(DAT_00700017).l  ; scale_x2_and_scroll_y
000dc76a  33fc0001007a0000      move.w #0x1,(line_counter).l  ; line_counter
000dc772  4e73                  rte
000dc774  ; 000dc774..000dc789  22 bytes the analysis never reached

; wf_snd_stream_word: wheelfir main. Stage of the raster chain that emits ONE word of the block to
;   the latch per scanline and advances the pointer. There are three variants with the same
;   instruction: 0xdc74e, 0xdc78a and 0xdc7c6, each at the end of a run of `nop`s the chain jumps
;   into. This one is never entered: no code writes a target inside its run (0xdc774..0xdc788) into
;   the jump at 0x201c8a
wf_snd_stream_word:
000dc78a  33ee040000740000      move.w (0x400,A6),(soundlatch).l  ; soundlatch
000dc792  548e                  addq.l 0x2,A6
000dc794  537900201cbc          subq.w 0x1,(wf_horizon).l
