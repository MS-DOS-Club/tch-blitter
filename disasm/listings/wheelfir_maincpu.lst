; wf_raster_starts_road: First raster IRQ of the frame: installs the road handler, arms the counter
;   with horizon+1 and advances the table cursor by as many entries
wf_raster_starts_road:
000dc5f6  3f00                  move.w D0w,-(SP)
000dc5f8  33fc000100201cba      move.w #0x1,(DAT_00201cba).l
