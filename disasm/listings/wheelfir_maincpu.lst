; wf_period_hz_table: wheelfir main. Period -> playback frequency in Hz table, read from the base
;   0xdab94 indexed by the period. Only periods 113..856 are read, so the table's bytes are
;   0xdac76..0xdb245 and it ends right where the volume matrix begins; the base itself is the
;   operand of the `lea` at 0xdab92 that loads it, and what lies between is code and
;   wf_note_period_table
wf_period_hz_table:
000dac76  7bbd                  dc.w 0x7bbd
000dac78  ; 000dac78..000db243  1484 bytes the analysis never reached
DAT_000db244:
000db244  105a                  dc.w 0x105a
000db246  ; 000db246..000db247  2 bytes the analysis never reached

; wf_volume_matrix_table: wheelfir main. A 64x64 byte matrix: index (channel_vol-1) +
;   64*(master_vol-1), value = the sub's volume table number (0..64). It occupies exactly
