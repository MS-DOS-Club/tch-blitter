; snd_soft_reset_stub: Stacks PC=0x400 and SR=0x2700 and does an `rte`, that is, a soft jump to the
;   reset. NO vector points at it.
snd_soft_reset_stub:
00000544  2f3c00000400          move.l #snd_reset,-(SP)
0000054a  3f3c2700              move.w #0x2700,-(SP)
0000054e  4e73                  rte

FUN_00000550:
00000550  4e73                  rte


; snd_rte_stub: A bare `rte` that 252 of the 256 exception vectors point at. The TRACE one (0x024)
;   points at its twin at 0x550.
snd_rte_stub:
00000552  4e73                  rte

; snd_isr_mixer: The whole mixer, and it is the IRQ1 handler. It is copied to RAM 0x201060 because
;   it SELF-MODIFIES: 24 slots (read opcode, table base, step and loop pointer, for each of the 6
;   voices) plus the target of the final `jmp`. 742 bytes, byte for byte identical in wheelfir,
;   pwball and radendur.
; runs from 0x00201060
snd_isr_mixer:
