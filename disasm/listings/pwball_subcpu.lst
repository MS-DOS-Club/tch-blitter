; snd_mix_out_l: Dumps the sum of voices 1+3+5 to the left DAC. `move.w d7, 0x700000.l`, a 16-bit
;   word of which the DAC uses the low 10 bits. No saturation and no clipping: the sum of three
;   bytes cannot pass 765, and that is why the DAC is 10 bits.
; runs from 0x002010c6
snd_mix_out_l:
000005ba  33c700700000          move.w D7w,(ldac).l
000005c0  4247                  clr.w D7w
000005c2  1e12                  move.b (A2),D7b
