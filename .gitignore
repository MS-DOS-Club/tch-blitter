# The MAME clone (several GB) and build artefacts, anchored to the root so a
# directory of the same name elsewhere in the tree is tracked
/upstream/
build/
tmp/

# The romsets are not distributed: each clone puts its own in run/mame_roms/ (README, Getting
# started), and radendurh.zip is built from the dump by scripts/radendurh.py.
run/mame_roms/*.zip

# Notes a maintainer's clone keeps locally and does not publish.
/.claude/docs
/.claude/plans
/.claude/roadmap
/.claude/upstream
/.claude/rules/public-face.md
/CLAUDE.local.md

# MAME runtime
*.cfg
*.nv
nvram/
snap/
cfg/

# local settings of the development environment
.claude/settings.local.json

# Disassembly: the images are regenerated by scripts/disasm.sh, the Ghidra project by make ghidra.
disasm/img/
disasm/*.asm
disasm/ghidra/
# graphics dumps of the ROM, regenerable
disasm/gfx/

# what a failing verify leaves beside its golden, to look at
goldens/**/*.actual.png

# macOS
.DS_Store

# Python (scripts/tooling)
__pycache__/
*.pyc
.venv/

# Ghidra and other downloaded tools (large, not versioned)
tools/

# the track maps at native resolution (scripts/radendur_tracks_all.py rebuilds them); the
# 1400 px versions the documents link are versioned
docs/img/radendur/tracks/full/
error.log
run/ui.ini

# the Python tools' caches (.venv and __pycache__ are above)
.pytest_cache/
.ruff_cache/
