+//-------------------------------------------------------------------------
+// The thread of the debugger's visible CPU, or 0 when the visible device
+// is not one of the CPUs the threads stand for.
+int debug_gdbstub::visible_thread_id()
+{
+	if ( m_debugger_console == nullptr )
+		return 0;
+	device_t const *const visible = m_debugger_console->get_visible_cpu();
+	for ( size_t i = 0; i < m_threads.size(); i++ )
+		if ( m_threads[i].cpu == visible )
+			return int(i + 1);
+	return 0;
+}
+
+//-------------------------------------------------------------------------
+// The visible CPU's thread, whose program space 'Z' and 'z' place and find
+// a watchpoint in, as its debugger lists it; the first CPU's when the
+// visible device is not one of the CPUs.
+debug_gdbstub::gdb_thread &debug_gdbstub::visible_thread()
+{
+	int const id = visible_thread_id();
+	return m_threads[id != 0 ? id - 1 : 0];
