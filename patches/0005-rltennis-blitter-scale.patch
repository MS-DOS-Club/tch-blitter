+// The two counters of 70000a as destination and source steps, a+1 and b+1 from the high
+// nibbles; an unexpected value is reported once and still decoded the same way.
+void rltennis_state::decode_scale(uint16_t scale, int &dst_steps, int &src_steps)
+{
+	const auto counter = [scale] (int shift) { return ((scale >> shift) & 0xf) + 1; };
+
+	dst_steps = counter(12);
+	src_steps = counter(4);
+
+	if (!m_scale_nibbles_logged && (counter(8) != dst_steps || counter(0) != src_steps))
+	{
+		m_scale_nibbles_logged = true;
+		logerror("scale register %04x does not repeat its nibbles; using the high ones\n", scale);
+	}
+	if (!m_scale_enlarge_logged && dst_steps > src_steps)
+	{
+		m_scale_enlarge_logged = true;
+		logerror("scale register %04x enlarges, which the game was never seen to ask for\n", scale);
+	}
+}
