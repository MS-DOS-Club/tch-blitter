+
+void radendur_state::port_7c0000_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	if (ACCESSING_BITS_8_15)
+	{
+		m_eeprom->di_write(BIT(data, 9));
+		m_eeprom->clk_write(BIT(data, 8));
+		m_eeprom->cs_write(BIT(data, 10));
+	}
+
+	if (ACCESSING_BITS_0_7)
+	{
+		// the link's data byte, to a second cabinet nobody is listening from (see tch/wheelfir.cpp)
+	}
+	if (ACCESSING_BITS_8_15)
+	{
+		// Bit 13 enables the line counter: 0x548 sets it on starting a sample block and 0xf2498
+		// (copied to RAM) clears it on ending it, an andi #$cfff then an ori #$1000, as the rest of
+		// the family does (see tch/wheelfir.cpp). Clearing it withdraws the pending level-5 request: the streamer is
+		// self-modifying code, and one extra handler after the close walks it out of its buffer.
+		const bool was_enabled = m_counter_enabled;
+		m_counter_enabled = BIT(data, 13);
+		if (was_enabled && !m_counter_enabled)
+			m_maincpu->set_input_line(5, CLEAR_LINE);
+	}
+
+}
+
+uint16_t radendur_state::port_7c0000_r(offs_t offset, uint16_t mem_mask)
+{
+	uint16_t data = 0;
+
+	if (ACCESSING_BITS_8_15)
+	{
+		// Bit 13 is the link receiver's status, held at one as in tch/wheelfir.cpp: a cabinet with
+		// no partner, nothing pending. No read of it by this game has been seen.
+		data |= 0x2000;
+		data |= m_eeprom->do_read() << 15;
+	}
+
+	return data;
+}
+
+void radendur_state::coin_cnt_w(uint16_t data)
+{
+	/* bits 0/1 coin counters */
+	machine().bookkeeping().coin_counter_w(0, data & 0x01);
+	machine().bookkeeping().coin_counter_w(1, data & 0x02);
+}
