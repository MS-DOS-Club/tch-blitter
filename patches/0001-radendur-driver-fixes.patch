+// license:BSD-3-Clause
+// copyright-holders:Tomasz Slanina, Marcos Hernández
+/****************************************************************
+
+Radical Enduro (TCH / Sator Videogames, unreleased prototype)
+
+The Wheels & Fire board (TCH Murcia, rev E133: two 68000, two Actel TPC1020BFN
+FPGAs as a scaling blitter, BT478 RAMDAC, ADC0808 for the wheel, 10-bit R2R
+DACs) running a game that uses it differently from its siblings in
+tch/wheelfir.cpp, which is why it has a driver of its own:
+
+- The track is a stack of isometric sprites sorted by depth, Knight Lore style,
+  not a raster-scrolled road: level 5 draws nothing here, it clocks the sound
+  streamer.
+- The sprite plane's page flip is decided on the blit, not on line 0 of the
+  frame, because the game issues its drawing chain inside vblank.
+- The palette the game uploads for a page takes effect when that page is
+  displayed, so the FG palette is snapshotted at the flip.
+- The dump is emulated as it is: the prototype's own faults hang it on its grey
+  exception screen. radendurv2 loads a maincpu ROM with those faults fixed in its
+  code, its sound block moved after the drawing chain as Power Ball and Kong
+  Ball place theirs, and, not the board's behaviour, its full scenery drawn: every
+  prop near the view, in the row it belongs to.
+
+Original driver by Tomasz Slanina.
+Its own driver split from wheelfir, the board's interrupt timing and the fixed
+clone by Marcos Hernández, in collaboration, within MS-DOS Club's TCH preservation
+project (github.com/MS-DOS-Club/tch-blitter).
+
+The blitter notes, the board and the register map are in tch/wheelfir.cpp, where the
+shared video model lives.
+
+*/
+
+#include "emu.h"
+
+#include "cpu/m68000/m68000.h"
+#include "machine/adc0808.h"
+#include "machine/eepromser.h"
+#include "machine/timer.h"
+#include "sound/dac.h"
+#include "video/ramdac.h"
+
+#include "emupal.h"
+#include "screen.h"
+#include "speaker.h"
+
+#include <algorithm>
+#include <cstring>
+
+
+namespace {
+
+static constexpr int ZOOM_TABLE_SIZE = 1 << 14;
+// Vblank starts on line 256, as in Wheels & Fire: it is the same board and no register moves the
+// line, so the game cannot ask for another. Any earlier and it fires inside the 252 lines the
+// monitor shows, so the last of them are painted while the vblank's palette upload is running.
+static constexpr int NUM_SCANLINES = 256;
+static constexpr int FIELD_LINES = 312;       // at the 15625 Hz line rate, the 50.08 Hz field
+static constexpr int VISIBLE_LINES = 252;
+static constexpr int PIXELS_PER_LINE = 512;   // MASTER_CLOCK/4 over these is the 15625 Hz line rate
+static constexpr XTAL MASTER_CLOCK = 32_MHz_XTAL; // the board's only crystal
+static constexpr int LAYER_BG = 0;
+static constexpr int LAYER_FG = 1;
+static constexpr int NUM_COLORS = 256;
+
+class radendur_state : public driver_device
+{
+public:
+	radendur_state(const machine_config &mconfig, device_type type, const char *tag) :
+		driver_device(mconfig, type, tag),
+		m_maincpu(*this, "maincpu"),
+		m_subcpu(*this, "subcpu"),
+		m_eeprom(*this, "eeprom"),
+		m_screen(*this, "screen"),
+		m_palette(*this, "palette"),
+		m_blitter_data(*this, "blitram"),
+		m_tilepages(*this, "gfx1")
+	{ }
+
+	void radendur(machine_config &config);
+
+	int adc_eoc_r();
+
+protected:
+	virtual void machine_start() override ATTR_COLD;
+	virtual void machine_reset() override ATTR_COLD;
+	virtual void video_start() override ATTR_COLD;
+
+private:
+	required_device<cpu_device> m_maincpu;
+	required_device<cpu_device> m_subcpu;
+	required_device<eeprom_serial_93cxx_device> m_eeprom;
+	required_device<screen_device> m_screen;
+	required_device<palette_device> m_palette;
+
+	std::unique_ptr<int32_t[]> m_zoom_table;
+	required_shared_ptr<uint16_t> m_blitter_data;
+	required_region_ptr<uint8_t> m_tilepages;
+
+	int32_t m_direct_write_x0 = 0;
+	int32_t m_direct_write_x1 = 0;
+	int32_t m_direct_write_y0 = 0;
+	int32_t m_direct_write_y1 = 0;
+	int32_t m_direct_write_idx = 0;
+	int32_t m_direct_write_layer = LAYER_BG;
+	bool m_direct_write_logged = false;   // a log latch, deliberately outside the save state
+
+	std::unique_ptr<bitmap_ind16> m_tmp_bitmap[2]{};
+	uint16_t m_latch_value = 0;
+	int m_hangs = 0, m_hang_frame = -1, m_hang_pc = 0;
+	bool m_counter_enabled = false;
+	uint16_t m_scanline_cnt = 0;   // unsigned where tch/wheelfir.cpp is signed: every count this game writes is below 0x8000
+	int32_t m_adc_eoc = 0;
+
+	// initialised: it is read in the first screen_update, before line 0 writes it
+	int32_t m_current_yscroll = 0;
+
+	// The FG is two pages of 256 rows that page-flip: m_fg_drawbuf is the half being drawn and
+	// m_fg_dispbuf the finished half screen_update shows. Which one is bit 0x20 of word 8.
+	int32_t m_fg_drawbuf = 0;
+	int32_t m_fg_dispbuf = 0;
+
+	// 0xffff to word 14 marks the next trigger as a fill; the arming write clears the mark
+	bool m_word14_fill = false;
+	bool m_blit_opaque = false;   // 0xff was written to word 13 since the arming
+
+	// One 256-colour LUT drives both planes and the game uploads a new one per FG page, so the FG
+	// palette is SNAPSHOTTED at the flip: FG-context pens accumulate in m_pal_fg_cur, become
+	// m_pal_fg_shown when their page flips in, and are pushed at vblank for the FG-owned indices;
+	// BG-context pens stay live. The context is the plane bit of word 7 at the time of the upload.
+	bool m_pal_fg_primed = false;                    // a flip has snapshotted a palette to apply
+	bool m_pal_fg_owned[NUM_COLORS] = { false };     // index last written in FG (flip-synced) vs BG (live) context
+	uint32_t m_pal_fg_cur[NUM_COLORS] = { 0 };       // FG palette accumulating live from the RAMDAC tap
+	uint32_t m_pal_fg_shown[NUM_COLORS] = { 0 };     // cur snapshotted at the flip = palette of the displayed page
+	uint8_t m_rd_idx = 0;
+	uint8_t m_rd_sub = 0;
+	uint8_t m_rd_comp[3] = { 0 };
+
+	int32_t get_scale(int32_t index)
+	{
+		while (index < ZOOM_TABLE_SIZE)
+		{
+			if (m_zoom_table[index] >= 0)
+			{
+				return m_zoom_table[index];
+			}
+			++index;
+		}
+		return 0;
+	}
+	void do_direct_write(uint8_t sixdat);
+	void flip_page(int buf);
+	void do_blit();
+	void blit_w(offs_t offset, uint16_t data, uint16_t mem_mask = ~0);
+	void port_7c0000_w(offs_t offset, uint16_t data, uint16_t mem_mask = ~0);
+	uint16_t port_7c0000_r(offs_t offset, uint16_t mem_mask = ~0);
+	void scanline_cnt_w(offs_t offset, uint16_t data, uint16_t mem_mask = ~0);
+	void latch_w(offs_t offset, uint16_t data, uint16_t mem_mask = ~0);
+	uint16_t latch_r(offs_t offset, uint16_t mem_mask = ~0);
+	void coin_cnt_w(uint16_t data);
+	void adc_eoc_w(int state);
+	uint32_t screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect);
+	void screen_vblank(int state);
+	TIMER_DEVICE_CALLBACK_MEMBER(scanline_timer_callback);
+	void ramdac_map(address_map &map) ATTR_COLD;
+	void main_map(address_map &map) ATTR_COLD;
+	void sub_map(address_map &map) ATTR_COLD;
+};
+
+// The page flip, decided on the blit and not on line 0 of the frame: this game issues its drawing
+// chain inside vblank, and a decision taken on line 0 arrives after the drawing it was to steer.
+// The half coming in is cleared by the game's own fill (see do_blit).
+void radendur_state::flip_page(int buf)
+{
+	if (buf == m_fg_drawbuf) return;
+	m_fg_dispbuf = m_fg_drawbuf;
+	m_fg_drawbuf = buf;
+	std::memcpy(m_pal_fg_shown, m_pal_fg_cur, sizeof(m_pal_fg_shown));
+	m_pal_fg_primed = true;
+}
+
+// The 0x7a0000 line counter: the game writes how many lines to wait, the beam decrements it and
+// at zero level 5 fires. Here it clocks the sound streamer and draws nothing; the game arms it from
+// 0x520 and 0x538, and its vector jumps to a trampoline in RAM (0x20f908 -> 0x203164).
+void radendur_state::scanline_cnt_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	COMBINE_DATA(&m_scanline_cnt);
+}
+
+void radendur_state::do_blit()
+{
+	// The blitter IRQ is a HELD LEVEL, up when a blit completes and down at the arming write, paced
+	// by the game's own mask: vblank (0x400) returns with mask 0 to open the chain, one interrupt
+	// per blit sustains it (0x1f94, 0x1f42), and the terminal handler 0x1fe6 returns with mask 1
+	// when the list runs out.
+	m_maincpu->set_input_line(1, ASSERT_LINE);
+
+	uint8_t const *const rom = m_tilepages;
+
+	const int src_u0 = (m_blitter_data[0] >> 8) + ((m_blitter_data[6] & 0x100) ? 256 : 0);
+	const int src_v0 = (m_blitter_data[2] >> 8) + ((m_blitter_data[6] & 0x200) ? 256 : 0);
+
+	int dst_x0 = (m_blitter_data[0] & 0xff) + ((m_blitter_data[7] & 0x40) ? 256 : 0);
+	int dst_y0 = (m_blitter_data[2] & 0xff) + ((m_blitter_data[7] & 0x80) ? 256 : 0);
+
+	int dst_x1 = (m_blitter_data[1] & 0xff) + ((m_blitter_data[9] & 4) ? 256 : 0);
+	int dst_y1 = (m_blitter_data[3] & 0xff) + ((m_blitter_data[9] & 8) ? 256 : 0);
+
+	const bool flipx = (m_blitter_data[7] & 0x1);
+	const bool flipy = (m_blitter_data[7] & 0x2);
+
+	// Word 7 bit 2 reads the source and bit 3 also writes index 0, as on tch/wheelfir.cpp: both
+	// together are a colour fill, bit 3 alone an ERASE that writes zeros and walks its destination
+	// in columns, axes swapped from the way it is declared.
+	const bool writes_zero = (m_blitter_data[7] & 0x08) != 0;
+	const bool erase = writes_zero && !(m_blitter_data[7] & 0x04);
+
+	int x_dst_step = flipx ? 1 : -1;
+	int y_dst_step = flipy ? 1 : -1;
+
+	const int u_src_step = (m_blitter_data[8] & 0x4000) ? 1 : -1;
+	const int v_src_step = (m_blitter_data[8] & 0x8000) ? 1 : -1;
+
+	const int page = ((m_blitter_data[6]) >> 10) * 0x40000;
+
+	// A word-14 fill clears the band of rows it declares, edge to edge of the plane; its two
+	// declared columns are only the seed. One naming no ROM page draws nothing and opens no
+	// direct-write window.
+	const bool fill_band = m_word14_fill && page < 0x700000;
+	if (m_word14_fill && !fill_band)
+		return;
+
+	const int vpage = (m_blitter_data[0x7] & 0x10) ? LAYER_BG : LAYER_FG;
+
+	// The board's direct-write channel, as tch/wheelfir.cpp models it: a page above the ROM defines
+	// the window, on the plane the blit names, and draws nothing. radendurv2 never opens it; the dump
+	// does on every blit once it hangs, so only the first opening is logged.
+	if (page >= 0x700000)
+	{
+		if (!m_direct_write_logged)
+		{
+			m_direct_write_logged = true;
+			logerror("%s: page %08x names no ROM: direct-write channel opened\n", machine().describe_context(), page);
+		}
+		m_direct_write_x0 = dst_x0;
+		m_direct_write_x1 = dst_x1;
+		m_direct_write_y0 = dst_y0;
+		m_direct_write_y1 = dst_y1;
+		m_direct_write_idx = 0;
+		m_direct_write_layer = vpage;
+		return;
+	}
+
+	// inclusive endpoints, as in rltennis: the walk steps in its declared direction until its 9-bit
+	// counter meets x1/y1, going round the plane when the end lies behind it (the game's left-edge
+	// strips start at x 505 and are drawn only that way)
+	dst_x0 &= 0x1ff;
+	dst_x1 &= 0x1ff;
+	dst_y0 &= 0x1ff;
+	dst_y1 &= 0x1ff;
+
+	if (vpage == LAYER_FG)
+	{
+		// The displayed half is bit 0x20 of word 8, composed once per frame by the vblank handler
+		// (0x506); with the bit set the blits draw into the LOW half, shown from the next
+		// flip. The flip is decided here, on the blit, and lives in flip_page alone.
+		{
+			const int buf = (m_blitter_data[0x8] & 0x0020) ? 0 : 1;
+			flip_page(buf);
+		}
+	}
+
+	// The game opens every chain with one of these on the sprite plane (0x21ac), clearing the half
+	// it is about to draw. The height is counted on the torus.
+	if (fill_band)
+	{
+		const int rows = ((dst_y1 - dst_y0) & 0x1ff) + 1;
+		const int end = dst_y0 + rows - 1;
+		m_tmp_bitmap[vpage]->fill(0, rectangle(0, 511, dst_y0, std::min(end, 511)));
+		if (end > 511)
+			m_tmp_bitmap[vpage]->fill(0, rectangle(0, 511, 0, end - 512));
+		return;
+	}
+
+	// From here an erase walks the declared y as x and the declared x as y, the steps going with
+	// their endpoints.
+	if (erase)
+	{
+		std::swap(dst_x0, dst_y0);
+		std::swap(dst_x1, dst_y1);
+		std::swap(x_dst_step, y_dst_step);
+	}
+
+	float scale_u_step;
+	float scale_v_step;
+
+	// This game writes one scale index for every blit (a census of words 8 and 10..12 over the
+	// attract and a race), so the zoom path below and its inclusive endpoints are unexercised;
+	// tch/wheelfir.cpp carries the board's scale law.
+	// calculate u zoom (horizontal source scale)
+	const int d1u = ((m_blitter_data[0x0a] & 0x1f00) >> 8) |
+					((m_blitter_data[0x08] & 0x0100) >> 3);
+	const int d2u = ((m_blitter_data[0x0b] & 0x1f00) >> 8) |
+					((m_blitter_data[0x08] & 0x0400) >> 5);
+	const int hflagu = (m_blitter_data[0x09] & 0x0001) ? 1 : 0;
+	const int dflagu = (m_blitter_data[0x08] & 0x1000) ? 1 : 0;
+	const int indexu = d1u | (d2u << 6) | (hflagu << 12) | (dflagu << 13);
+	const float scale_u = get_scale(indexu);
+
+	// calculate v zoom (vertical source scale)
+	const int d1v = ((m_blitter_data[0x0b] & 0xc000) >> 14) |
+					((m_blitter_data[0x0c] & 0xc000) >> 12) |
+					((m_blitter_data[0x0a] & 0x4000) >> 10) |
+					((m_blitter_data[0x08] & 0x0200) >> 4);
+
+	const int d2v = ((m_blitter_data[0x0c] & 0x1f00) >> 8) |
+					((m_blitter_data[0x08] & 0x0800) >> 6);
+	const int hflagv = (m_blitter_data[0x09] & 0x0002) ? 1 : 0;
+	const int dflagv = (m_blitter_data[0x08] & 0x2000) ? 1 : 0;
+	const int indexv = d1v | (d2v << 6) | (hflagv << 12) | (dflagv << 13);
+	const float scale_v = get_scale(indexv);
+
+	if (scale_u == 0 || scale_v == 0) return;
+
+	scale_u_step = 100.f / scale_u;
+	scale_v_step = 100.f / scale_v;
+
+	// do the draw
+	int y = dst_y0;
+	// The first sampled source row of a 1:1 blit is a 1px garbage edge in the gfx ROMs. It is
+	// skipped at 1:1 only, where one source row is one screen row.
+	const float v_bias = (scale_v == 100.f) ? 1.0f : 0.0f;
+
+	float idx_v = 0;
+	do
+	{
+		int x = dst_x0;
+		float idx_u = 0;
+
+		int yy = src_v0 + v_src_step * (idx_v + v_bias);
+
+		do
+		{
+			int xx = src_u0 + u_src_step * idx_u;
+
+			// the source wraps inside its 512x512 page: a sprite reaching the edge would read the
+			// next ROM
+			int address = page + (yy & 0x1ff) * 512 + (xx & 0x1ff);
+
+			// an erase writes index 0, not the source pixel
+			int pix = erase ? 0 : rom[address & (0x1000000 - 1)];
+
+			// x and y are masked to the plane on every step: the destination WRAPS on both planes,
+			// as in tch/wheelfir.cpp
+			if (pix || writes_zero || m_blit_opaque)
+			{
+				m_tmp_bitmap[vpage]->pix(y, x) = pix;
+			}
+
+			// the endpoint is part of the blit
+			if (x == dst_x1) break;
+
+			x += x_dst_step;
+			x &= 0x1ff;
+			idx_u += scale_u_step;
+
+		} while (true);
+
+		if (y == dst_y1) break;
+
+		y += y_dst_step;
+		y &= 0x1ff;
+		idx_v += scale_v_step;
+
+	} while (true);
+
+}
+
+void radendur_state::do_direct_write(uint8_t sixdat)
+{
+	const int direct_width = m_direct_write_x1 - m_direct_write_x0 + 1;
+	const int direct_height = m_direct_write_y1 - m_direct_write_y0 + 1;
+
+	if (direct_width > 0 && direct_height > 0)
+	{
+		int x = m_direct_write_idx % direct_width;
+		int y = (m_direct_write_idx / direct_width) % direct_height;
+
+		x += m_direct_write_x0;
+		y += m_direct_write_y0;
+
+		if (x < 512 && y < 512)
+		{
+			m_tmp_bitmap[m_direct_write_layer]->pix(y, x) = sixdat;
+		}
+	}
+
+	++m_direct_write_idx;
+}
+
+void radendur_state::blit_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	m_screen->update_partial(m_screen->vpos() - 1);
+	if (offset == 0xe && data == 0xffff) m_word14_fill = true;
+	COMBINE_DATA(&m_blitter_data[offset]);
+
+	// The transparency mode is a register, as on tch/wheelfir.cpp: a write to the low byte of word
+	// 12 selects transparent and to word 13 opaque, and the arming write resets it. The game
+	// selects opaque at four boot blits (0x26d0, 0x2790, 0x28aa, 0x296a) and in the display-list
+	// interpreter at 0x20fa (a fill) and 0x2220.
+	if (offset == 0xc && ACCESSING_BITS_0_7) m_blit_opaque = false;
+	if (offset == 0xd && ACCESSING_BITS_0_7) m_blit_opaque = true;
+
+	if (offset == 0x6)
+	{
+		if (!ACCESSING_BITS_8_15)  //LSB only!
+		{
+			do_direct_write(data & 0xff);
+			return;
+		}
+	}
+
+	// Latched on the X write where tch/wheelfir.cpp latches on the Y write. Unexercised by this game
+	// (a census of its scroll writers over the attract and a race): the vblank pair (0x4d2, 0x4d8)
+	// is overridden at line 0, and the mid-frame pair (0x74a, 0x750) was never reached.
+	if (offset == 0xa)
+	{
+		if (!ACCESSING_BITS_8_15)  //LSB only!
+		{
+			// written during the active frame, the scroll counts from the current line
+			m_current_yscroll = (m_blitter_data[0xb] & 0x00ff) | (m_blitter_data[0x8] & 0x0080) << 1;
+			m_current_yscroll -= m_screen->vpos();
+			return;
+		}
+	}
+
+
+	if (offset == 0xf)
+	{
+		if (data == 0xffff)
+		{
+			do_blit();
+		}
+		else if (data == 0x0000)
+		{
+			// Arming resets the fill mark and ACKNOWLEDGES the blitter, as on tch/wheelfir.cpp: the
+			// held IRQ line drops here and the next fire raises it again.
+			m_word14_fill = false;
+			m_blit_opaque = false;
+			m_maincpu->set_input_line(1, CLEAR_LINE);
+		}
+		else
+		{
+			// the game writes only 0x0000 (arm) and 0xffff (fire) here
+			logerror("%s: write to offset 0xf (blit start) but with data %04x\n", machine().describe_context(), data);
+		}
+	}
+}
+
+void radendur_state::video_start()
+{
+	m_tmp_bitmap[0] = std::make_unique<bitmap_ind16>(512, 512);
+	m_tmp_bitmap[1] = std::make_unique<bitmap_ind16>(512, 512);
+
+	// Both planes persist between frames and are painted blit by blit, so they are state.
+	for (int i = 0; i < 2; i++)
+		save_pointer(&m_tmp_bitmap[i]->pix(0), "m_tmp_bitmap",
+				u32(m_tmp_bitmap[i]->rowpixels()) * m_tmp_bitmap[i]->height(), i);
+}
+
+uint32_t radendur_state::screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect)
+{
+
+	bitmap.fill(0, cliprect);
+
+	for (int y = cliprect.min_y; y <= cliprect.max_y; y++)
+	{
+		int scrolly = y;
+		scrolly += m_current_yscroll;
+		scrolly &= 0x1ff;
+		uint16_t const *const source = &m_tmp_bitmap[LAYER_BG]->pix(scrolly);
+		uint16_t *const dest = &bitmap.pix(y);
+
+		for (int x = cliprect.min_x; x <= cliprect.max_x; x++)
+		{
+			int sourcex = x;
+			sourcex += (m_blitter_data[0xa] & 0x00ff) | (m_blitter_data[0x8] & 0x0040) << 2;
+			sourcex &= 0x1ff;
+			dest[x] = source[sourcex];
+		}
+	}
+
+
+	// The FG is composited unscrolled: given the BG scroll, it would move the attract logos with it.
+	const int displayed_page = m_fg_dispbuf;
+	copybitmap_trans(bitmap, *m_tmp_bitmap[LAYER_FG], 0, 0, 0, -displayed_page * 256, cliprect, 0);
+
+	return 0;
+}
