+// The blitter starts out idle with its line asserted, in machine_reset because the 68000's reset
+// clears its input lines; the game opens the mask only after installing its RAM trampoline.
+void radendur_state::machine_reset()
+{
+	m_maincpu->set_input_line(1, ASSERT_LINE);
+	m_counter_enabled = false;
+}
