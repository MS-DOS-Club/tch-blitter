+void radendur_state::main_map(address_map &map)
+{
+	map(0x000000, 0x0fffff).rom();
+	map(0x200000, 0x20ffff).ram().mirror(0x010000); // as in tch/wheelfir.cpp: whether the board decodes the mirror is not established
+
+	map(0x700000, 0x70001f).w(FUNC(radendur_state::blit_w)).share(m_blitter_data);
+	map(0x720001, 0x720001).w("ramdac", FUNC(ramdac_device::index_w));
+	map(0x720003, 0x720003).w("ramdac", FUNC(ramdac_device::pal_w));
+	map(0x720005, 0x720005).w("ramdac", FUNC(ramdac_device::mask_w)); // word write?
+	map(0x740000, 0x740001).w(FUNC(radendur_state::latch_w));
+	map(0x760000, 0x760001).w(FUNC(radendur_state::coin_cnt_w));
+	map(0x780000, 0x78000f).rw("adc", FUNC(adc0808_device::data_r), FUNC(adc0808_device::address_offset_start_w)).umask16(0x00ff);
+	map(0x7a0000, 0x7a0001).w(FUNC(radendur_state::scanline_cnt_w));
+	map(0x7c0000, 0x7c0001).rw(FUNC(radendur_state::port_7c0000_r), FUNC(radendur_state::port_7c0000_w));
+	map(0x7e0000, 0x7e0001).portr("P1");
+	map(0x7e0002, 0x7e0003).portr("P2");
+}
