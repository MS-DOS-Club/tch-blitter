+TIMER_DEVICE_CALLBACK_MEMBER(radendur_state::scanline_timer_callback)
+{
+	if (param == 0)
+	{
+		// the frame starts from the last scroll the game wrote
+		m_current_yscroll = (m_blitter_data[0xb] & 0x00ff) | (m_blitter_data[0x8] & 0x0080) << 1;
+
+	}
+
+	if (param < NUM_SCANLINES) // the scanned lines; vblank starts at NUM_SCANLINES
+	{
+		// the line counter runs only while the game enables it (bit 13 of the control port): level 5
+		// is the streamer's clock
+		if (m_counter_enabled && m_scanline_cnt > 0)
+		{
+			m_scanline_cnt--;
+			if (m_scanline_cnt == 0)
+			{
+				m_maincpu->set_input_line(5, HOLD_LINE);
+			}
+		}
+
+	}
+	else
+	{
+		if (param == NUM_SCANLINES) /* vblank */
+		{
+			if (m_hangs && m_hang_frame >= 0 && int(m_screen->frame_number()) > m_hang_frame)
+			{
+				address_space &sp = m_maincpu->space(AS_PROGRAM);
+				logerror("FRAME ssw=%04x address=%08x opcode=%04x sr=%04x "
+						"pc=%08x\n", sp.read_word(0x20f8f4), sp.read_dword(0x20f8f6),
+						sp.read_word(0x20f8fa), sp.read_word(0x20f8fc), sp.read_dword(0x20f8fe));
+				m_hang_frame = -1;
+			}
+			m_maincpu->set_input_line(3, HOLD_LINE);
+		}
+	}
+
+	m_subcpu->set_input_line(1, HOLD_LINE);
+}
