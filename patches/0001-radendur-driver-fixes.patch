+void radendur_state::machine_start()
+{
+	// THE HANG DUMP, always on: the game's exception handler (0x25a4) dumps the 68000's exception
+	// frame to 0x20f8f4 and paints grey forever, so the faulting address and pc are read from
+	// there on the next vblank, with the object drawer's window and cursor, which is where it dies.
+	m_maincpu->space(AS_PROGRAM).install_write_tap(0x20f8f4, 0x20f907, "radendur_hang",
+		[this](offs_t offset, u16 &data, u16 mem_mask)
+		{
+			if (offset != 0x20f8f4) return;          // only the first long of the frame
+			// only the hang handler's own writes (0x25a8..0x25bc): a boot routine uses the area too
+			const offs_t pc_hang = m_maincpu->pcbase();
+			if (pc_hang < 0x25a8 || pc_hang > 0x25bc) return;
+			m_hangs++;
+			if (m_hangs > 1) return;
+			address_space &sp = m_maincpu->space(AS_PROGRAM);
+			// the frame is read later, on the next vblank: only its first long is written here
+			m_hang_frame = int(m_screen->frame_number());
+			m_hang_pc = int(m_maincpu->pcbase());
+			logerror("HANG on frame %d (handler pc=%06x). The exception frame "
+					"is left at 0x20f8f4\n", m_hang_frame, m_hang_pc);
+
+			// and the object drawer's window, which set its loop count `d7 = min - max - 1` (MIN at
+			// 0x20173a, MAX at 0x20173c); its registers are gone, the handler has reused A0
+			const u16 vmin = sp.read_word(0x20173a);
+			const u16 vmax = sp.read_word(0x20173c);
+			logerror("DRAWER window min=%04x max=%04x d7=%d\n",
+					vmin, vmax, int(s16(u16(vmin - vmax - 1))));
+		});
+
+	// The RAMDAC taps follow the BT478 protocol (index, then R, G, B with auto-increment) to route
+	// each pen by the plane context of its upload; see the palette members.
+	m_maincpu->space(AS_PROGRAM).install_write_tap(0x720000, 0x720001, "radendur_rd_index",
+		[this](offs_t offset, u16 &data, u16 mem_mask)
+		{
+			m_rd_idx = data & 0xff;
+			m_rd_sub = 0;
+		});
+	m_maincpu->space(AS_PROGRAM).install_write_tap(0x720002, 0x720003, "radendur_rd_data",
+		[this](offs_t offset, u16 &data, u16 mem_mask)
+		{
+			m_rd_comp[m_rd_sub] = data & 0xff;
+			if (++m_rd_sub == 3) // R, G, B collected -> one pen
+			{
+				if (m_blitter_data[0x7] & 0x10)
+				{
+					m_pal_fg_owned[m_rd_idx] = false;
+				}
+				else
+				{
+					m_pal_fg_cur[m_rd_idx] = (m_rd_comp[0] << 16) | (m_rd_comp[1] << 8) | m_rd_comp[2];   // 0x00RRGGBB
+					m_pal_fg_owned[m_rd_idx] = true;
+				}
+				m_rd_idx = (m_rd_idx + 1) & 0xff;   // BT478 auto-increments the index
+				m_rd_sub = 0;
+			}
+		});
+
+	save_item(NAME(m_fg_drawbuf));
+	save_item(NAME(m_fg_dispbuf));
+	save_item(NAME(m_pal_fg_primed));
+	save_item(NAME(m_pal_fg_owned));
+	save_item(NAME(m_pal_fg_cur));
+	save_item(NAME(m_pal_fg_shown));
+	save_item(NAME(m_rd_idx));
+	save_item(NAME(m_rd_sub));
+	save_item(NAME(m_rd_comp));
+	// the rest of what survives between frames: half a state loads as a fault somewhere else (the
+	// hang dump's counters are diagnostics and stay out)
+	save_item(NAME(m_word14_fill));
+	save_item(NAME(m_blit_opaque));
+	save_item(NAME(m_scanline_cnt));
+	save_item(NAME(m_current_yscroll));
+	save_item(NAME(m_adc_eoc));
+	save_item(NAME(m_direct_write_x0));
+	save_item(NAME(m_direct_write_x1));
+	save_item(NAME(m_direct_write_y0));
+	save_item(NAME(m_direct_write_y1));
+	save_item(NAME(m_direct_write_idx));
+	save_item(NAME(m_direct_write_layer));
+	save_item(NAME(m_latch_value));
+	save_item(NAME(m_counter_enabled));
+
+	m_zoom_table = std::make_unique<int32_t[]>(ZOOM_TABLE_SIZE);
+
+	for (int i = 0; i < (ZOOM_TABLE_SIZE); ++i)
+	{
+		m_zoom_table[i] = -1;
+	}
+
+	for (int j = 0; j < 400; ++j)
+	{
+		m_zoom_table[ZOOM_INDEX[j]] = j;
+	}
+
+}
+
+// The latch between the two CPUs: one word, no queue, so a second write before the read drops the
+// first, and the sub CPU patches each word into its mix loop, so a shifted stream corrupts its code.
+// A plain register, not generic_latch_16_device: the device defers each write through the
+// scheduler, and with it the sound CPU loses the stream partway into a race and the music stops.
+void radendur_state::latch_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	m_latch_value = data;
+}
+
+uint16_t radendur_state::latch_r(offs_t offset, uint16_t mem_mask)
+{
+	return m_latch_value;
+}
